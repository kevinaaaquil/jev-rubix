# Copy to .env.local and fill in. Never commit the filled-in file.
# cp .env.example .env.local

# Required. Moonshot (Kimi) API key — read server-side only, in app/api/solve/route.js.
# Get one at https://platform.moonshot.ai
MOONSHOT_API_KEY=

# Optional. Defaults to kimi-k2.6, the cheapest model most keys can reach.
# Others: kimi-k2.7-code, kimi-k2.7-code-highspeed, kimi-k3
# Check what yours allows: curl -H "Authorization: Bearer $MOONSHOT_API_KEY" \
#   https://api.moonshot.ai/v1/models
KIMI_MODEL=

# Required for the "Solve using Jev" button. TypeSafe AI key (System One / Jev),
# read server-side only, in app/api/jev/route.js. https://console.typesafe.ai/
TYPESAFE_API_KEY=

# Optional. Defaults to jev-latest.
JEV_MODEL=

# Optional. "disabled" (default) or "enabled". k2.6 reasons by default and can
# spend every token thinking about a cube without ever answering, so the solve
# route turns thinking off. Set to enabled for slow, expensive, deeper attempts.
KIMI_THINKING=

# Optional. USD per 1M tokens, only if your account's rates differ from the
# built-in table. Defaults for kimi-k2.6: 0.95 / 0.16 / 4.00
KIMI_PRICE_IN=
KIMI_PRICE_CACHED=
KIMI_PRICE_OUT=
